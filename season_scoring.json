      "close_result_threshold": 5,
      "top_candidates": 3
    },
    "temperature_dependency": {
      "primary_source": "temperature_engine.output.classification",
      "fallback_source": "feature_extraction.overall_impression.dominant_temperature",
      "minimum_temperature_engine_confidence": 0.45
    },
    "value_dependency": {
      "primary_source": "value_engine.output.classification",
      "fallback_source": "feature_extraction.overall_impression.dominant_value",
      "minimum_value_engine_confidence": 0.45
    },
    "chroma_dependency": {
      "primary_source": "chroma_engine.output.classification",
      "fallback_source": "feature_extraction.overall_impression.dominant_chroma",
      "minimum_chroma_engine_confidence": 0.45
    },
    "contrast_dependency": {
      "primary_source": "contrast_engine.output.classification",
      "fallback_source": "feature_extraction.overall_impression.dominant_contrast",
      "minimum_contrast_engine_confidence": 0.45
    },
    "exclusion_dependency": {
      "module": "exclusion_rules",
      "apply_after": "base_dimension_scoring",
      "apply_before": "confusion_resolution"
    }
  },
  "scoring_algorithm": {
    "status": "implemented_spec_v1",
    "dimension_weights": {
      "temperature": 0.3,
      "value": 0.25,
      "chroma": 0.25,
      "contrast": 0.2
    },
    "dimension_match_values": {
      "exact_target": 1.0,
      "accepted_value": 0.75,
      "adjacent_value": 0.4,
      "opposite_value": 0.0
    },
    "dimension_score_formula": "dimension_points = dimension_weight * match_value * dimension_confidence",
    "base_score_formula": "base_score = 100 * sum(available_dimension_points) / sum(available_dimension_weights * dimension_confidence)",
    "unknown_dimension_rule": "Ignore unknown or low-confidence dimensions and renormalize the remaining available dimensions.",
    "minimum_dimension_confidence": 0.4,
    "minimum_available_dimension_weight": 0.45,
    "rounding": {
      "intermediate_precision": 4,
      "final_score_precision": 1
    },
    "score_bounds": {
      "minimum": 0,
      "maximum": 100
    }
  },
  "dimension_resolution": {
    "temperature": {
      "primary": "temperature_engine.output.classification",
      "confidence": "temperature_engine.output.confidence",
      "fallback": "feature_extraction.overall_impression.dominant_temperature"
    },
    "value": {
      "primary": "value_engine.output.classification",
      "confidence": "value_engine.output.confidence",
      "fallback": "feature_extraction.overall_impression.dominant_value"
    },
    "chroma": {
      "primary": "chroma_engine.output.classification",
      "confidence": "chroma_engine.output.confidence",
      "fallback": "feature_extraction.overall_impression.dominant_chroma"
    },
    "contrast": {
      "primary": "contrast_engine.output.classification",
      "confidence": "contrast_engine.output.confidence",
      "fallback": "feature_extraction.overall_impression.dominant_contrast"
    }
  },
  "score_modifiers": {
    "status": "implemented_spec_v1",
    "cross_dimension": {
      "minor_boost": 3,
      "moderate_boost": 6,
      "strong_boost": 10,
      "minor_penalty": -4,
      "moderate_penalty": -8,
      "strong_penalty": -15
    },
    "exclusions": {
      "hard_exclusion_score": 0,
      "hard_exclusion_flag": true,
      "soft_penalty_application": "add penalty to base score and clamp to 0..100"
    },
    "confusion_resolution": {
      "point_to_score_conversion": 1.5,
      "maximum_score_adjustment": 9,
      "winner_adjustment": "min(points_margin * 1.5, 9)",
      "loser_adjustment": "negative winner adjustment",
      "unresolved_when_margin_below": 2
    }
  }
