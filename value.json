{
  "value_engine": {
    "status": "implemented_v1",
    "purpose": "Estimate the overall lightness/depth of appearance from observable skin, natural hair, eyes, and feature contrast before season scoring.",
    "output": {
      "light_score": "0..100",
      "medium_score": "0..100",
      "deep_score": "0..100",
      "classification": "light|medium|deep|uncertain",
      "confidence": "0..1",
      "evidence": "array[object]",
      "conflicts": "array[string]"
    },
    "evidence_priority": [
      {
        "source": "skin",
        "weight": 0.35,
        "reason": "Stable primary evidence when exposure and skin visibility are acceptable."
      },
      {
        "source": "hair",
        "weight": 0.4,
        "reason": "Strong evidence only when hair is natural or likely natural."
      },
      {
        "source": "eyes",
        "weight": 0.15,
        "reason": "Supporting evidence for overall depth."
      },
      {
        "source": "eyebrows",
        "weight": 0.05,
        "reason": "Low-weight supporting evidence."
      },
      {
        "source": "overall_impression",
        "weight": 0.05,
        "reason": "Used only as a cross-check, not as a substitute for observed features."
      }
    ],
    "global_rules": {
      "minimum_total_evidence_weight": 0.35,
      "minimum_confidence_for_source_use": 0.4,
      "unknown_handling": "Ignore unknown fields and renormalize available source weights.",
      "hair_handling": {
        "natural": 1.0,
        "likely_natural": 0.85,
        "possibly_colored": 0.45,
        "colored": 0.0,
        "unknown": 0.35
      },
      "exposure_adjustment": {
        "good": 1.0,
        "acceptable": 0.8,
        "overexposed": 0.55,
        "underexposed": 0.55,
        "severe_overexposure": 0.0,
        "severe_underexposure": 0.0
      },
      "never_use_as_single_decisive_evidence": [
        "skin_depth",
        "hair_depth",
        "eye_depth",
        "overall_impression"
      ],
      "conflict_handling": "If light and deep evidence are both strong, classify as medium unless one side exceeds the other by at least 18 points."
    },
    "mapping": {
      "skin_depth": {
        "very_light": {
          "light": 1.0,
          "medium": 0.1,
          "deep": 0.0
        },
        "light": {
          "light": 0.85,
          "medium": 0.25,
          "deep": 0.0
        },
        "light_medium": {
          "light": 0.55,
          "medium": 0.6,
          "deep": 0.05
        },
        "medium": {
          "light": 0.15,
          "medium": 1.0,
          "deep": 0.15
        },
        "medium_deep": {
          "light": 0.05,
          "medium": 0.6,
          "deep": 0.55
        },
        "deep": {
          "light": 0.0,
          "medium": 0.2,
          "deep": 1.0
        },
        "unknown": null
      },
      "hair_depth": {
        "very_light": {
          "light": 1.0,
          "medium": 0.1,
          "deep": 0.0
        },
        "light": {
          "light": 0.85,
          "medium": 0.25,
          "deep": 0.0
        },
        "light_medium": {
          "light": 0.55,
          "medium": 0.6,
          "deep": 0.05
        },
        "medium": {
          "light": 0.15,
          "medium": 1.0,
          "deep": 0.15
        },
        "medium_deep": {
          "light": 0.05,
          "medium": 0.6,
          "deep": 0.55
        },
        "deep": {
          "light": 0.0,
          "medium": 0.2,
          "deep": 0.9
        },
        "very_deep": {
          "light": 0.0,
          "medium": 0.05,
          "deep": 1.0
        },
        "unknown": null
      },
      "eye_base_color": {
        "very_light_blue": {
          "light": 0.9,
          "medium": 0.15,
          "deep": 0.0
        },
        "blue": {
          "light": 0.7,
          "medium": 0.35,
          "deep": 0.0
        },
        "blue_gray": {
          "light": 0.6,
          "medium": 0.45,
          "deep": 0.0
        },
        "gray": {
          "light": 0.5,
          "medium": 0.5,
          "deep": 0.05
        },
        "green": {
          "light": 0.4,
          "medium": 0.6,
          "deep": 0.1
        },
        "gray_green": {
          "light": 0.4,
          "medium": 0.6,
          "deep": 0.1
        },
        "hazel": {
          "light": 0.2,
          "medium": 0.75,
          "deep": 0.25
        },
        "amber": {
          "light": 0.2,
          "medium": 0.7,
          "deep": 0.3
        },
        "light_brown": {
          "light": 0.15,
          "medium": 0.75,
          "deep": 0.3
        },
        "medium_brown": {
          "light": 0.05,
          "medium": 0.7,
          "deep": 0.55
        },
        "dark_brown": {
          "light": 0.0,
          "medium": 0.35,
          "deep": 0.85
        },
        "black_brown": {
          "light": 0.0,
          "medium": 0.15,
          "deep": 1.0
        },
        "mixed": {
          "light": 0.2,
          "medium": 0.65,
          "deep": 0.25
        },
        "unknown": null
      },
      "eye_brightness_modifier": {
        "high": {
          "light": 0.1,
          "medium": 0.0,
          "deep": -0.05
        },
        "medium": {
          "light": 0.0,
          "medium": 0.05,
          "deep": 0.0
        },
        "low": {
          "light": -0.05,
          "medium": 0.0,
          "deep": 0.1
        },
        "unknown": null
      },
      "eyebrow_depth_relative_to_hair": {
        "lighter": {
          "light": 0.1,
          "medium": 0.0,
          "deep": -0.05
        },
        "same": {
          "light": 0.0,
          "medium": 0.05,
          "deep": 0.0
        },
        "darker": {
          "light": -0.05,
          "medium": 0.0,
          "deep": 0.1
        },
        "unknown": null
      },
      "overall_value": {
        "light": {
          "light": 1.0,
          "medium": 0.2,
          "deep": 0.0
        },
        "medium": {
          "light": 0.15,
          "medium": 1.0,
          "deep": 0.15
        },
        "deep": {
          "light": 0.0,
          "medium": 0.2,
          "deep": 1.0
        },
        "uncertain": null
      }
    },
    "source_rules": {
      "skin": {
        "field": "feature_extraction.skin.dominant_depth",
        "confidence_field": "feature_extraction.skin.confidence"
      },
      "hair": {
        "field": "feature_extraction.hair.depth",
        "confidence_field": "feature_extraction.hair.confidence",
        "naturalness_field": "feature_extraction.hair.naturalness"
      },
      "eyes": {
        "base_field": "feature_extraction.eyes.base_color",
        "brightness_field": "feature_extraction.eyes.brightness",
        "confidence_field": "feature_extraction.eyes.confidence",
        "internal_weights": {
          "base_color": 0.85,
          "brightness_modifier": 0.15
        }
      },
      "eyebrows": {
        "field": "feature_extraction.eyebrows.depth_relative_to_hair",
        "confidence_field": "feature_extraction.eyebrows.confidence"
      },
      "overall_impression": {
        "field": "feature_extraction.overall_impression.dominant_value",
        "confidence_field": "feature_extraction.overall_impression.confidence"
      }
    },
    "classification_thresholds": {
      "light": {
        "minimum_light_score": 60,
        "minimum_gap_over_deep": 18,
        "minimum_gap_over_medium": 5
      },
      "medium": {
        "minimum_medium_score": 50,
        "maximum_light_deep_gap_for_balanced_case": 17
      },
      "deep": {
        "minimum_deep_score": 60,
        "minimum_gap_over_light": 18,
        "minimum_gap_over_medium": 5
      },
      "uncertain": {
        "when": [
          "total_evidence_weight_below_minimum",
          "total_confidence_below_0.40",
          "strong_exposure_distortion",
          "strong_source_conflicts",
          "quality_analysis_continue_analysis_false"
        ]
      }
    },
    "confidence_rules": {
      "base": "weighted_mean_of_used_feature_confidences",
      "quality_multipliers": {
        "good": 1.0,
        "acceptable": 0.8,
        "poor": 0.0
      },
      "exposure_penalty": {
        "none": 0.0,
        "moderate": 0.1,
        "strong": 0.25
      },
      "hair_colored_penalty": 0.08,
      "source_conflict_penalty": {
        "none": 0.0,
        "moderate": 0.1,
        "strong": 0.25
      }
    },
    "season_effects": {
      "light": {
        "boost": [
          "light_spring",
          "light_summer"
        ],
        "penalize": [
          "deep_autumn",
          "deep_winter"
        ]
      },
      "medium": {
        "boost": [
          "true_spring",
          "bright_spring",
          "true_summer",
          "soft_summer",
          "soft_autumn",
          "true_autumn",
          "bright_winter"
        ],
        "penalize": []
      },
      "deep": {
        "boost": [
          "deep_autumn",
          "true_winter",
          "deep_winter"
        ],
        "penalize": [
          "light_spring",
          "light_summer"
        ]
      }
    },
    "evidence_log_schema": {
      "source": "skin|hair|eyes|eyebrows|overall_impression",
      "field": "string",
      "observed_value": "string",
      "light_contribution": "number",
      "medium_contribution": "number",
      "deep_contribution": "number",
      "weight_used": "number",
      "feature_confidence": "0..1",
      "note": "string"
    }
  }
}