        "brown_rose": {
          "warm": 0.45,
          "cool": 0.35
        },
        "neutral": {
          "warm": 0.3,
          "cool": 0.3,
          "neutral": 0.4
        },
        "unknown": null
      },
      "internal_weights": {
        "temperature": 0.7,
        "natural_color": 0.3
      }
    },
    "eyes_rules": {
      "temperature": {
        "warm": {
          "warm": 1.0,
          "cool": 0.0
        },
        "neutral_warm": {
          "warm": 0.75,
