          "cool": 0.4
        },
        "cool_gray_veil_dominant": {
          "warm": 0.05,
          "cool": 0.55
        }
      },
      "base_color_note": "Base eye color must not determine temperature alone. Blue eyes can be warm-neutral; brown eyes can be cool-neutral.",
      "internal_weights": {
        "temperature": 0.75,
        "golden_flecks": 0.125,
        "cool_gray_veil": 0.125
      }
    },
    "hair_rules": {
      "temperature": {
        "warm": {
          "warm": 1.0,
          "cool": 0.0
        },
        "neutral_warm": {
          "warm": 0.75,
