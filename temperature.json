        },
        "neutral_cool": {
          "warm": 0.15,
          "cool": 0.75
        },
        "cool": {
          "warm": 0.0,
          "cool": 1.0
        },
        "uncertain": null
      },
      "supporting_markers": {
        "golden_flecks_visible": {
          "warm": 0.35,
