    },
    "eyebrows_rules": {
      "temperature": {
        "warm": {
          "warm": 0.7,
          "cool": 0.1
        },
        "cool": {
          "warm": 0.1,
          "cool": 0.7
        },
        "neutral": {
          "warm": 0.3,
          "cool": 0.3,
          "neutral": 0.4
        },
        "uncertain": null
      }
    },
    "classification_thresholds": {
      "warm": {
        "minimum_warm_score": 65,
        "minimum_gap_over_cool": 20
      },
      "neutral_warm": {
        "minimum_warm_score": 52,
        "minimum_gap_over_cool": 8
      },
      "neutral": {
        "maximum_gap_between_warm_and_cool": 7,
        "minimum_total_confidence": 0.5
      },
      "neutral_cool": {
        "minimum_cool_score": 52,
        "minimum_gap_over_warm": 8
      },
      "cool": {
        "minimum_cool_score": 65,
        "minimum_gap_over_warm": 20
      },
      "uncertain": {
        "when": [
          "total_evidence_weight_below_minimum",
          "total_confidence_below_0.40",
          "strong_feature_conflicts",
          "quality_analysis_continue_analysis_false"
        ]
      }
    },
    "confidence_rules": {
      "base": "weighted_mean_of_used_feature_confidences",
      "quality_multipliers": {
        "good": 1.0,
        "acceptable": 0.8,
        "poor": 0.0
      },
      "conflict_penalty": {
        "none": 0.0,
        "moderate": 0.1,
        "strong": 0.25
      },
      "hair_colored_penalty": 0.05,
      "heavy_makeup_penalty": 0.1,
      "white_balance_uncertain_penalty": 0.15
    },
    "evidence_log_schema": {
      "source": "skin|lips|eyes|hair|eyebrows",
      "field": "string",
      "observed_value": "string",
      "warm_contribution": "number",
      "cool_contribution": "number",
      "neutral_contribution": "number",
      "weight_used": "number",
      "feature_confidence": "0..1",
      "note": "string"
    }
  }
}
