{
  "chroma_engine": {
    "status": "implemented_v1",
    "purpose": "Estimate whether the overall appearance is bright, clear, balanced, soft, or muted from observable skin, eyes, hair, lips, and feature definition before season scoring.",
    "output": {
      "bright_score": "0..100",
      "clear_score": "0..100",
      "balanced_score": "0..100",
      "soft_score": "0..100",
      "muted_score": "0..100",
      "classification": "bright|clear|balanced|soft|muted|uncertain",
      "confidence": "0..1",
      "evidence": "array[object]",
      "conflicts": "array[string]"
    },
    "evidence_priority": [
      {
        "source": "eyes",
        "weight": 0.3,
        "reason": "Eye clarity and iris definition are strong indicators of clear versus muted appearance."
      },
      {
        "source": "skin",
        "weight": 0.25,
        "reason": "Skin clarity and translucency support the overall chroma assessment."
      },
      {
        "source": "hair",
        "weight": 0.2,
        "reason": "Natural hair clarity and shine are useful when hair is not colored."
      },
      {
        "source": "contrast",
        "weight": 0.15,
        "reason": "Feature definition helps separate bright or clear appearance from soft or muted appearance."
      },
      {
        "source": "lips",
        "weight": 0.05,
        "reason": "Natural lip clarity is low-weight supporting evidence."
      },
      {
        "source": "overall_impression",
        "weight": 0.05,
        "reason": "Used only as a consistency check."
      }
    ],
    "global_rules": {
      "minimum_total_evidence_weight": 0.35,
      "minimum_confidence_for_source_use": 0.4,
      "unknown_handling": "Ignore unknown fields and renormalize available source weights.",
      "hair_handling": {
        "natural": 1.0,
        "likely_natural": 0.85,
        "possibly_colored": 0.45,
        "colored": 0.0,
        "unknown": 0.35
      },
      "makeup_handling": {
        "none": 1.0,
        "light": 0.9,
        "visible": 0.65,
        "heavy": 0.3,
        "unknown": 0.7
      },
      "never_use_as_single_decisive_evidence": [
        "eye_brightness",
        "skin_translucency",
        "hair_shine",
        "feature_definition",
        "lip_color"
      ],
      "conflict_handling": "If clear or bright evidence and soft or muted evidence are both strong, classify as balanced unless one side exceeds the other by at least 15 points.",
      "terminology_rule": {
        "bright": "highest visible chroma and strongest visual impact",
        "clear": "clean, fresh, defined chroma without necessarily extreme intensity",
        "balanced": "neither distinctly bright nor distinctly muted",
        "soft": "gently blended and low-definition appearance",
        "muted": "clearly greyed, smoky, dusty, or subdued appearance"
      }
    },
    "mapping": {
