          "true_spring",
          "bright_spring",
          "bright_winter",
          "true_winter"
        ],
        "penalize": [
          "soft_summer",
          "soft_autumn"
        ]
      },
      "balanced": {
        "boost": [
          "light_spring",
          "light_summer",
          "true_autumn",
          "deep_autumn",
          "deep_winter"
        ],
        "penalize": []
      },
      "soft": {
        "boost": [
          "light_summer",
          "true_summer",
          "soft_summer",
          "soft_autumn"
        ],
        "penalize": [
          "bright_spring",
          "bright_winter"
        ]
      },
      "muted": {
        "boost": [
          "soft_summer",
          "soft_autumn",
          "true_summer"
        ],
        "penalize": [
          "bright_spring",
          "bright_winter",
          "true_spring",
          "true_winter"
        ]
      }
    },
    "evidence_log_schema": {
      "source": "skin|eyes|hair|contrast|lips|overall_impression",
      "field": "string",
      "observed_value": "string",
      "bright_contribution": "number",
      "clear_contribution": "number",
      "balanced_contribution": "number",
      "soft_contribution": "number",
      "muted_contribution": "number",
      "weight_used": "number",
      "feature_confidence": "0..1",
      "note": "string"
    }
  }
