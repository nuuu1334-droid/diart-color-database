    "source_rules": {
      "skin": {
        "clarity_field": "feature_extraction.skin.clarity",
        "translucency_field": "feature_extraction.skin.translucency",
        "confidence_field": "feature_extraction.skin.confidence",
        "internal_weights": {
          "clarity": 0.8,
          "translucency": 0.2
        }
      },
      "eyes": {
        "clarity_field": "feature_extraction.eyes.clarity",
        "brightness_field": "feature_extraction.eyes.brightness",
        "iris_contrast_field": "feature_extraction.eyes.iris_contrast",
        "limbal_ring_field": "feature_extraction.eyes.limbal_ring",
        "confidence_field": "feature_extraction.eyes.confidence",
        "internal_weights": {
          "clarity": 0.5,
          "brightness": 0.2,
          "iris_contrast": 0.2,
          "limbal_ring": 0.1
        }
      },
      "hair": {
        "clarity_field": "feature_extraction.hair.clarity",
        "shine_field": "feature_extraction.hair.shine",
        "confidence_field": "feature_extraction.hair.confidence",
        "naturalness_field": "feature_extraction.hair.naturalness",
        "internal_weights": {
          "clarity": 0.75,
          "shine": 0.25
        }
      },
      "contrast": {
        "field": "feature_extraction.contrast.feature_definition",
        "confidence_field": "feature_extraction.contrast.confidence"
      },
      "lips": {
        "field": "feature_extraction.lips.clarity",
        "confidence_field": "feature_extraction.lips.confidence"
      },
      "overall_impression": {
        "field": "feature_extraction.overall_impression.dominant_chroma",
        "confidence_field": "feature_extraction.overall_impression.confidence"
      }
    },
    "classification_thresholds": {
      "bright": {
        "minimum_bright_score": 62,
        "minimum_gap_over_muted": 22,
        "minimum_gap_over_soft": 15
      },
      "clear": {
        "minimum_clear_score": 58,
        "minimum_gap_over_muted": 18,
        "minimum_gap_over_soft": 10
      },
      "balanced": {
        "minimum_balanced_score": 48,
        "maximum_clear_muted_gap_for_balanced_case": 14
      },
      "soft": {
        "minimum_soft_score": 55,
        "minimum_gap_over_clear": 10,
        "minimum_gap_over_bright": 15
      },
      "muted": {
        "minimum_muted_score": 62,
        "minimum_gap_over_clear": 18,
        "minimum_gap_over_bright": 22
      },
      "uncertain": {
        "when": [
          "total_evidence_weight_below_minimum",
          "total_confidence_below_0.40",
          "heavy_makeup_and_low_natural_feature_visibility",
          "strong_source_conflicts",
          "quality_analysis_continue_analysis_false"
        ]
      }
    },
    "confidence_rules": {
      "base": "weighted_mean_of_used_feature_confidences",
      "quality_multipliers": {
        "good": 1.0,
        "acceptable": 0.8,
        "poor": 0.0
      },
      "makeup_penalty": {
        "none": 0.0,
        "light": 0.02,
        "visible": 0.08,
        "heavy": 0.18,
        "unknown": 0.05
      },
      "hair_colored_penalty": 0.05,
      "filter_or_beauty_processing_penalty": {
        "none": 0.0,
        "possible": 0.1,
        "visible": 0.2
      },
      "source_conflict_penalty": {
        "none": 0.0,
        "moderate": 0.1,
        "strong": 0.25
      }
    },
    "season_effects": {
      "bright": {
        "boost": [
          "bright_spring",
          "bright_winter"
        ],
        "penalize": [
          "soft_summer",
          "soft_autumn"
        ]
      },
      "clear": {
